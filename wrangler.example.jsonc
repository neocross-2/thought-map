{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thought-map",
  "compatibility_date": "2026-07-25",
  "pages_build_output_dir": "./out",
  "d1_databases": [
    {
      "binding": "TREEMAP_DB",
      "database_name": "thought-map",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TREEMAP_ASSETS",
      "bucket_name": "thought-map-assets"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  }
}
